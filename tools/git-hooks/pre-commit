#!/usr/bin/env sh
# A release gate for the version number only.
#
# Automatically bump the patch version unless the user already staged an
# explicit version change, so that any commit reaching main is releasable.
#
# This hook deliberately does NOT rebuild the compendium packs.
#
# It used to. `packs/` was a build output of the private `_source` CSV pipeline,
# so every commit ran `release.ps1 -UpdatePacks`, which replaces each declared
# pack directory wholesale. Once the bulk data entry finished, that arrangement
# was all cost: it forced Foundry to be closed in order to commit, it churned
# LevelDB blobs on every commit, and -- twice on 2026-07-31 -- it destroyed
# edits made inside Foundry before they ever reached a commit.
#
# `packs/` is now the source of truth for compendium content. Edits are made in
# Foundry and committed directly. The CSV pipeline survives for bulk reshaping
# only, behind a manual `tools/release.ps1 -UpdatePacks`, which recovers
# Foundry-side edits into _source before it replaces anything. See CLAUDE.md,
# "컴펜디움 릴리즈".

set -eu

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

BASE_VERSION="$(git show HEAD:system.json 2>/dev/null | node -e 'let s=""; process.stdin.on("data", c => s += c).on("end", () => { try { console.log(JSON.parse(s).version) } catch { console.log("") } })')"
STAGED_VERSION=""
if ! git diff --cached --quiet -- system.json; then
  STAGED_VERSION="$(git show :system.json | node -e 'let s=""; process.stdin.on("data", c => s += c).on("end", () => console.log(JSON.parse(s).version))')"
fi

# An explicit version is a release-authoring choice. Otherwise every normal
# commit receives the next patch version and therefore becomes releasable when
# it reaches main.
if [ -z "$STAGED_VERSION" ] || [ "$STAGED_VERSION" = "$BASE_VERSION" ]; then
  node tools/bump-version.mjs system.json
  git add -- system.json
  STAGED_VERSION="$(git show :system.json | node -e 'let s=""; process.stdin.on("data", c => s += c).on("end", () => console.log(JSON.parse(s).version))')"
fi

echo "DX3rd | version $BASE_VERSION -> $STAGED_VERSION"

# Pack changes are staged by hand now. Auto-staging every declared pack made
# sense while the hook produced them; it does not when they carry whatever was
# last touched in Foundry. Say so rather than silently leaving them behind.
#
# Ask whether anything under packs/ is left OUT of this commit -- not whether the
# commit contains no packs at all. Staging one pack out of eight is the easiest
# way to drop Foundry edits on the floor, and a "nothing staged" test stays quiet
# through exactly that case.
LEFT_BEHIND=""
if ! git diff --quiet -- packs; then LEFT_BEHIND=1; fi
if [ -n "$(git ls-files --others --exclude-standard -- packs)" ]; then LEFT_BEHIND=1; fi
if [ -n "$LEFT_BEHIND" ]; then
  # A pack rotation touches dozens of LevelDB files, so name the packs, not the
  # files -- a 48-line dump is noise nobody reads.
  PACK_NAMES="$(git status --porcelain -- packs | sed 's/^...//; s#^packs/\([^/]*\)/.*#\1#' | sort -u | tr '\n' ' ')"
  echo "DX3rd | note: packs/ has changes this commit leaves behind: $PACK_NAMES" >&2
  echo "DX3rd |       run 'git add packs' if the compendium edits belong in it." >&2
fi
