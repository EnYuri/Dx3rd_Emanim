#!/usr/bin/env sh
# A private-source release gate.
#
# Automatically bump the patch version unless the user already staged an
# explicit version change. Then rebuild declared compendium packs from the
# untracked private _source directory and stage only those pack results. This
# lets the public GitHub Action publish the exact local build without ever
# receiving source material.

set -eu

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

BASE_VERSION="$(git show HEAD:system.json 2>/dev/null | node -e 'let s=""; process.stdin.on("data", c => s += c).on("end", () => { try { console.log(JSON.parse(s).version) } catch { console.log("") } })')"
STAGED_VERSION=""
if ! git diff --cached --quiet -- system.json; then
  STAGED_VERSION="$(git show :system.json | node -e 'let s=""; process.stdin.on("data", c => s += c).on("end", () => console.log(JSON.parse(s).version))')"
fi

# An explicit version is a release-authoring choice. Otherwise every normal
# commit receives the next patch version and therefore becomes releasable when
# it reaches main.
if [ -z "$STAGED_VERSION" ] || [ "$STAGED_VERSION" = "$BASE_VERSION" ]; then
  node tools/bump-version.mjs system.json
  git add -- system.json
  STAGED_VERSION="$(git show :system.json | node -e 'let s=""; process.stdin.on("data", c => s += c).on("end", () => console.log(JSON.parse(s).version))')"
fi

# Recover Foundry-side hand-tuning BEFORE the rebuild below replaces packs/.
#
# The rebuild is wholesale (release.ps1 moves each declared pack directory away and
# puts the freshly built one in its place), so anything edited inside Foundry and not
# yet represented in _source is destroyed by this very commit -- it never even reaches
# the commit. That happened for real on 2026-07-31 (38 icons plus one item's
# mechanization). Recovering first turns the rebuild into a no-op for those edits.
#
# Order matters twice over: this must run before release.ps1 because the recovery's
# baseline IS the previous build output still sitting in _source/. Regenerating first
# would destroy the baseline and make legitimate _source edits look like pack
# hand-tuning, pinning the old values as overrides forever.
echo "DX3rd | recovering Foundry-side pack edits into _source before rebuild"
set +e
node tools/recover-pack-edits.mjs --all --write
RECOVER_STATUS=$?
set -e
if [ "$RECOVER_STATUS" -eq 3 ]; then
  echo "DX3rd | pack recovery skipped: no LevelDB reader available (set FOUNDRY_APP_PATH to enable)" >&2
elif [ "$RECOVER_STATUS" -eq 4 ]; then
  echo "DX3rd | the recovery baseline no longer matches packs/ (a _source generator ran on its own)." >&2
  echo "DX3rd | Hand-tuning and _source edits are indistinguishable in that state, so this commit stops here." >&2
  exit 4
elif [ "$RECOVER_STATUS" -ne 0 ]; then
  echo "DX3rd | pack recovery failed -- aborting commit rather than rebuilding over unsaved edits." >&2
  exit "$RECOVER_STATUS"
fi
# Only these two files are tracked inside the otherwise-private _source tree.
# Use an if-block, not `[ -f x ] && git add x`: under `set -e` a false test is the
# list's exit status and would abort the commit with no message at all.
for f in _source/item-mech-overrides.json _source/effect-mech-overrides.json; do
  if [ -f "$f" ]; then git add -- "$f"; fi
done

echo "DX3rd | version $BASE_VERSION -> $STAGED_VERSION: building private compendia before commit"

if command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/release.ps1 -UpdatePacks
elif command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -File tools/release.ps1 -UpdatePacks
else
  echo "DX3rd | PowerShell is required to build release packs." >&2
  exit 1
fi

# Do not stage undeclared/legacy packs or unrelated working-tree changes.
node -e '
  const fs = require("fs");
  const { spawnSync } = require("child_process");
  const packs = JSON.parse(fs.readFileSync("system.json", "utf8")).packs.map(p => `packs/${p.name}`);
  const r = spawnSync("git", ["add", "--", ...packs], { stdio: "inherit" });
  process.exit(r.status ?? 1);
'
